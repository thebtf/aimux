{
  "servers": {
    "gopls": {
      "command": "C:\\Users\\btf\\go\\bin\\gopls.exe",
      "args": [
        "serve"
      ],
      "fileTypes": [
        ".go",
        ".mod",
        ".sum"
      ],
      "rootMarkers": [
        "go.mod",
        "go.work",
        "go.sum"
      ],
      "settings": {
        "gopls": {
          "analyses": {
            "unusedparams": true,
            "shadow": true
          },
          "staticcheck": true,
          "gofumpt": true
        }
      }
    }
  },
  "idleTimeoutMs": 300000
}
